@startuml
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1F4E79
skinparam ArrowFontColor #333333
skinparam ArrowFontSize 12
skinparam TitleFontColor #17365D
skinparam RectangleBackgroundColor #EDF2F8
skinparam RectangleBorderColor #17365D
skinparam RectangleFontColor #17365D
skinparam ComponentBackgroundColor #EDF2F8
skinparam ComponentBorderColor #17365D
skinparam PackageBackgroundColor #FAFCFE
skinparam PackageBorderColor #1F4E79
skinparam DatabaseBackgroundColor #E7F3EC
skinparam DatabaseBorderColor #1E7B45
skinparam QueueBackgroundColor #E7F3EC
skinparam QueueBorderColor #1E7B45
skinparam CloudBackgroundColor #F5F5F0
skinparam CloudBorderColor #595959
skinparam NodeBackgroundColor #EDF2F8
skinparam NodeBorderColor #17365D
skinparam ClassBackgroundColor #EDF2F8
skinparam ClassBorderColor #17365D
skinparam ClassFontColor #17365D
skinparam ClassAttributeFontSize 11
skinparam EntityBackgroundColor #EDF2F8
skinparam EntityBorderColor #17365D
skinparam UsecaseBackgroundColor #E7F3EC
skinparam UsecaseBorderColor #1E7B45
skinparam ActorBorderColor #17365D
skinparam ActorBackgroundColor #FFFFFF
skinparam ActivityBackgroundColor #EDF2F8
skinparam ActivityBorderColor #17365D
skinparam ActivityDiamondBackgroundColor #FFF6E0
skinparam ActivityDiamondBorderColor #9C6500
skinparam StateBackgroundColor #EDF2F8
skinparam StateBorderColor #17365D
skinparam SequenceParticipantBackgroundColor #EDF2F8
skinparam SequenceParticipantBorderColor #17365D
skinparam SequenceLifeLineBorderColor #BFC9D4
skinparam SequenceGroupBackgroundColor #F5F8FB
skinparam SequenceGroupBorderColor #1F4E79
skinparam ObjectBackgroundColor #EDF2F8
skinparam ObjectBorderColor #17365D
skinparam NoteBackgroundColor #FFF6E0
skinparam NoteBorderColor #9C6500
@enduml
