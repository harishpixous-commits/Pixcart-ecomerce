ORDER ||--|{ SUB_ORDER : splits
SUB_ORDER ||--|{ ORDER_LINE : contains
ORDER ||--|{ PAYMENT : paid_by
PAYMENT ||--o{ REFUND : reversed_by
SUB_ORDER ||--o{ SHIPMENT : fulfilled_by
ORDER_LINE ||--o{ RMA : returned_via
SUB_ORDER ||--o{ LEDGER_ENTRY : accrues
SETTLEMENT_BATCH ||--o{ LEDGER_ENTRY : settles
COUPON ||--o{ COUPON_REDEMPTION : redeemed
ORDER ||--o{ COUPON_REDEMPTION : uses
@enduml
