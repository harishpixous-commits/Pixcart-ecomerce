# PixCart — environment configuration example
#
# Every variable below was derived by scanning the repository for actual references, not from a
# generic template. The comment on each names the file that reads it, so a reviewer can verify the
# list is complete rather than trusting it.
#
#   Verify with:
#     grep -rn "IDENTITY_DB_URL" services/*/src/main/resources/
#     grep -rn "ANTHROPIC_API_KEY" ai/orchestrator/src/
#
# Copy to .env and fill in. NEVER commit a filled-in .env — .gitignore excludes it.


# ─────────────────────────────────────────────────────────────────────────────
# Database — read by services/identity-svc/src/main/resources/application.yml
# ─────────────────────────────────────────────────────────────────────────────
# The only service with a Spring Boot entry point today (see docs/LIMITATIONS.md §2).
# Schema is created by the Flyway migrations in db/migration (V001–V005, 25 tables).
IDENTITY_DB_URL=jdbc:mysql://localhost:3306/pixcart
IDENTITY_DB_USER=pixcart
IDENTITY_DB_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# AI provider — read by ai/orchestrator/src/adapters/llm-config.ts
# ─────────────────────────────────────────────────────────────────────────────
# The resolver accepts EITHER an Anthropic first-party key OR a Claude-on-AWS key, and
# reports precisely which it received. Set exactly one.
#
# An Anthropic first-party key begins "sk-ant-". If ANTHROPIC_API_KEY is set to something
# that is neither an sk-ant- key nor a decodable AWS long-term key, the resolver REFUSES
# rather than guessing — see llm-config.ts and docs/CREDENTIALS.md.
ANTHROPIC_API_KEY=

# Claude-on-AWS long-term key. Requires AWS egress, which the build sandbox does not have.
CLAUDE_AWS_API_KEY=

# Optional: pin a model. Defaults are set in llm-config.ts.
LLM_MODEL=

# Optional: the Console → Quickstart gateway URL, when using the AWS path.
LLM_GATEWAY_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Voice — Sarvam adapter
# ─────────────────────────────────────────────────────────────────────────────
# Currently unverified: the key supplied during development was the literal placeholder
# string "YOUR_SARVAM_API_KEY". See docs/LIMITATIONS.md §4.
SARVAM_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Payments — NOT YET BOUND TO A PROVIDER
# ─────────────────────────────────────────────────────────────────────────────
# PaymentGatewayPort and PayoutGateway are implemented and tested against fakes, but no
# concrete provider adapter exists because the provider has not been chosen. Uncomment the
# block matching the chosen provider once that decision is made. See docs/LIMITATIONS.md §1.
#
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
#
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_WEBHOOK_SECRET=
#
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=


# ─────────────────────────────────────────────────────────────────────────────
# Notification providers — consumed by the FR-ADM-015 notification centre
# ─────────────────────────────────────────────────────────────────────────────
# The centre models provider weights, health and auto-failover as domain logic; these are
# the credentials a concrete channel adapter would need. No adapter is wired yet.
#
# ESP_PRIMARY_API_KEY=
# ESP_SECONDARY_API_KEY=
# ESP_WEBHOOK_SIGNING_SECRET=
#
# SMS templates must carry a registered DLT id (TRAI). The id lives on the template row,
# not here; this is the sender registration used to submit them.
# DLT_ENTITY_ID=
# DLT_SENDER_ID=
#
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_KEY_ID=
# APNS_TEAM_ID=


# ─────────────────────────────────────────────────────────────────────────────
# Media / CDN — consumed by the FR-CUS-012 image-search and avatar paths
# ─────────────────────────────────────────────────────────────────────────────
# Image search enforces CDN-hosted image URLs, so the allowed host must be configured.
# CDN_ALLOWED_HOSTS=cdn.pixcart.example
# MEDIA_SIGNING_SECRET=
