<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BAL\BAL.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\Utils\Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the reference API's sign-in/permission rule per route (tools/schema/route_guards.py) -->
    <EmbeddedResource Include="Infrastructure/route-guards.json" LogicalName="API.Infrastructure.route-guards.json" />
    <!-- the reference API's query-string rules per route (tools/schema/query_rules.py) -->
    <EmbeddedResource Include="Infrastructure/query-rules.json" LogicalName="API.Infrastructure.query-rules.json" />
  </ItemGroup>

</Project>
