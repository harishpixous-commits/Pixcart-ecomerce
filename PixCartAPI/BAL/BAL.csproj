<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DAL\DAL.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\Utils\Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- built-in Tamil and Hindi lines for the site (TranslateBAL) -->
    <EmbeddedResource Include="Assets\i18n\*.json" />
    <!-- the admin assistant's tool specs, generated from the reference by tools/schema/assistant_tool_specs.py -->
    <EmbeddedResource Include="Assets\assistant\tool-specs.json" LogicalName="BAL.Assets.assistant.tool-specs.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
