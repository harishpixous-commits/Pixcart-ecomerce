 {
  "name": "file_overview",
  "description": "Columns, types, totals and first rows of a file the person uploaded (defaults to the latest one).",
  "input_schema": {
   "type": "object",
   "properties": {
    "file_id": {
     "type": "string"
    }
   },
   "required": []
  }
 },
 {
  "name": "file_query",
  "description": "Exact counts, sums, averages, min or max over the uploaded file, optionally filtered and grouped.",
  "input_schema": {
   "type": "object",
   "properties": {
    "file_id": {
     "type": "string"
    },
    "filters": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "column": {
        "type": "string"
       },
       "op": {
        "type": "string",
        "enum": [
         "equals",
         "not_equals",
         "contains",
         "greater_than",
         "less_than",
         "is_empty",
         "not_empty"
        ]
       },
       "value": {
        "type": "string"
       }
      }
     }
    },
    "group_by": {
     "type": "string"
    },
    "metric": {
     "type": "string",
     "enum": [
      "count",
      "sum",
      "average",
      "min",
      "max"
     ]
    },
    "value_column": {
     "type": "string"
    },
    "sort": {
     "type": "string",
     "enum": [
      "desc",
      "asc"
     ]
    },
    "limit": {
     "type": "integer"
    }
   },
   "required": []
  }
 },
 {
  "name": "file_compare",
  "description": "Matches each row of the uploaded file to live orders, packages, products (SKU), payouts, customers or sellers and lists missing records and differences (amounts in rupees, stock, status). Columns are detected from the headers unless given.",
  "input_schema": {
   "type": "object",
   "properties": {
    "file_id": {
     "type": "string"
    },
    "entity": {
     "type": "string",
     "enum": [
      "orders",
      "packages",
      "products",
      "payouts",
      "customers",
      "sellers"
     ]
    },
    "key_column": {
     "type": "string"
    },
    "columns": {
     "type": "object",
     "description": "live field -> file column, e.g. {\"total\": \"Amount\"}",
     "additionalProperties": {
      "type": "string"
     }
    }
   },
   "required": [
    "entity"
   ]
  }
 },
 {
  "name": "propose_action",
  "description": "Prepares a change for the person to confirm with a button. Nothing changes until they press Confirm. kinds: approve_product, reject_product, approve_seller, reject_seller, suspend_seller, set_seller_commission, cancel_package, mark_delivered, retry_refund, return_decision, block_customer, unblock_customer, create_coupon, set_coupon_active, reply_ticket, moderate_review, update_setting, set_announcement, run_payouts. Look records up first so the params are exact.",
  "input_schema": {
   "type": "object",
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "approve_product",
      "reject_product",
      "approve_seller",
      "reject_seller",
      "suspend_seller",
      "set_seller_commission",
      "cancel_package",
      "mark_delivered",
      "retry_refund",
      "return_decision",
      "block_customer",
      "unblock_customer",
      "create_coupon",
      "set_coupon_active",
      "reply_ticket",
      "moderate_review",
      "update_setting",
      "set_announcement",
      "run_payouts"
     ]
    },
    "params": {
     "type": "object",
     "description": "see each kind; e.g. {\"package\": \"PC123-1\", \"reason\": \"...\"}"
    }
   },
   "required": [
    "kind",
    "params"
   ]
  }
 },
