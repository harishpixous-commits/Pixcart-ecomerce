[
 {
  "name": "business_overview",
  "description": "Sales, orders, average order value, cancellations, returns, commission, COD vs online and new customers for a period. Use for 'how much did we sell', 'today's orders', 'this month's revenue'. Optional filters narrow it to one seller, category, payment method or state.",
  "input_schema": {
   "type": "object",
   "properties": {
    "period": {
     "type": "string",
     "enum": [
      "today",
      "yesterday",
      "this_week",
      "last_week",
      "this_month",
      "last_month",
      "last_7_days",
      "last_30_days",
      "last_90_days",
      "this_quarter",
      "this_year",
      "this_financial_year",
      "last_financial_year",
      "custom"
     ],
     "description": "Time range in India time. Use custom with date_from/date_to for other dates."
    },
    "date_from": {
     "type": "string",
     "description": "YYYY-MM-DD, only with period=custom"
    },
    "date_to": {
     "type": "string",
     "description": "YYYY-MM-DD, only with period=custom"
    },
    "compare": {
     "type": "boolean",
     "description": "Also return the previous period of the same length"
    },
    "seller": {
     "type": "string",
     "description": "store name, GSTIN or id"
    },
    "category": {
     "type": "string"
    },
    "payment_method": {
     "type": "string",
     "enum": [
      "cod",
      "online"
     ]
    },
    "state_code": {
     "type": "string",
     "description": "2-digit GST state code, e.g. 33 for Tamil Nadu"
    }
   },
   "required": []
  }
 },
 {
