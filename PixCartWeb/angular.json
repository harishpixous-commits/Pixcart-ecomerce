{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "PixCartWeb": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/mukta/400.css",
              "node_modules/@fontsource/mukta/500.css",
              "node_modules/@fontsource/mukta/600.css",
              "node_modules/@fontsource/baloo-2/500.css",
              "node_modules/@fontsource/baloo-2/600.css",
              "node_modules/@fontsource/baloo-2/700.css",
              "node_modules/@fontsource/poppins/500.css",
              "node_modules/@fontsource/poppins/600.css",
              "node_modules/@fontsource/poppins/700.css",
              "node_modules/@fontsource/inter/400.css",
              "node_modules/@fontsource/inter/500.css",
              "node_modules/@fontsource/inter/600.css",
              "node_modules/@fontsource/inter/700.css",
              "node_modules/@fontsource/plus-jakarta-sans/400.css",
              "node_modules/@fontsource/plus-jakarta-sans/500.css",
              "node_modules/@fontsource/plus-jakarta-sans/600.css",
              "node_modules/@fontsource/plus-jakarta-sans/700.css",
              "node_modules/@fontsource/plus-jakarta-sans/800.css",
              "node_modules/@fontsource/playfair-display/500.css",
              "node_modules/@fontsource/playfair-display/600.css",
              "node_modules/@fontsource/playfair-display/700.css",
              "node_modules/leaflet/dist/leaflet.css",
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "PixCartWeb:build:production"
            },
            "development": {
              "buildTarget": "PixCartWeb:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "port": 4201
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}