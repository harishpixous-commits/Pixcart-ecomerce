{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixcart.pixoustech.com/contracts/events/order.confirmed.v1.json",
  "title": "order.confirmed.v1",
  "description": "Producer: Order. Consumers: Finance, Notification, Analytics, Vendor-portal projector. Vol.5 §5.5: orderId, subOrders[], totals, promoAllocation; exactly-once effect via eventId dedup. Mirrors Order.create output (Slice 5, BRU-03 split).",
  "type": "object",
  "required": ["orderId", "quoteId", "paymentRef", "grandTotalPaise", "subOrders"],
  "additionalProperties": false,
  "properties": {
    "orderId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "quoteId": { "type": "string", "minLength": 1 },
    "paymentRef": { "type": "string", "minLength": 1, "description": "Capture ref; order is idempotent on it (FR-CUS-014)." },
    "grandTotalPaise": { "type": "integer", "minimum": 1 },
    "subOrders": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subOrderId", "vendorId", "lineIds", "amountPaise", "state"],
        "additionalProperties": false,
        "properties": {
          "subOrderId": { "type": "string", "minLength": 1 },
          "vendorId": { "type": "string", "minLength": 1 },
          "lineIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "amountPaise": { "type": "integer", "minimum": 1 },
          "state": { "type": "string", "const": "CONFIRMED", "description": "Every sub-order starts CONFIRMED." }
        }
      }
    }
  }
}
