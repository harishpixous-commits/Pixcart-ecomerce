{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixcart.pixoustech.com/contracts/events/shipment.status.v1.json",
  "title": "shipment.status.v1",
  "description": "Producer: Logistics. Consumers: Order timeline, Notification, Finance (delivery-confirm). Vol.5 §5.5: canonical status enum, POD ref, courier, eventTime (courier) vs ingestTime. status enum mirrors SubOrderLifecycle fulfilment states (Slice 5).",
  "type": "object",
  "required": ["subOrderId", "status", "courier", "eventTime"],
  "additionalProperties": false,
  "properties": {
    "subOrderId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["SHIPPED", "OUT_FOR_DELIVERY", "DELIVERED", "NDR", "RTO_INITIATED", "RTO_RECEIVED"] },
    "courier": { "type": "string", "minLength": 1 },
    "podRef": { "type": "string", "description": "Proof-of-delivery reference (on DELIVERED)." },
    "ndrAttempt": { "type": "integer", "minimum": 0, "maximum": 3, "description": "NDR re-attempt count (cap 3, Slice 5)." },
    "eventTime": { "type": "string", "format": "date-time", "description": "Courier-reported time." },
    "ingestTime": { "type": "string", "format": "date-time", "description": "Platform ingest time." }
  }
}
