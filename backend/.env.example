# Copy to .env for local development. In production these come from AWS Secrets Manager and the ECS
# task definition (see infra/terraform). Everything optional can stay empty: the feature simply stays off.

# ---------------------------------------------------------------- core
ENVIRONMENT=development                # development | production
APP_NAME=PixCart                        # first brand name; change it any time in Admin → Storefront
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pixcart
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- security (REQUIRED in production)
JWT_SECRET=                             # python -c "import secrets; print(secrets.token_urlsafe(48))"
FIELD_ENCRYPTION_KEY=                   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_SECURE=false                     # true in production (HTTPS)
TRUST_PROXY_HEADERS=false               # true behind the ALB
TRUSTED_PROXY_COUNT=1                   # proxies that append X-Forwarded-For (ALB only = 1)
LOG_FORMAT=console                      # json in production
SENTRY_DSN=                             # optional error tracking

# ---------------------------------------------------------------- login OTP (MSG91, DLT-registered template)
SMS_PROVIDER=console                    # console prints OTPs to the log (development only) | msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ---------------------------------------------------------------- payments (Razorpay); empty = cash on delivery only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WINDOW_MINUTES=30

# ---------------------------------------------------------------- seller payouts
PAYOUT_MODE=manual                      # manual (bank CSV + UTR) | razorpayx (automatic)
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# ---------------------------------------------------------------- messages to customers and sellers
SMTP_HOST=                              # e.g. email-smtp.ap-south-1.amazonaws.com (Amazon SES)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.in          # the sender name is the brand name from Admin → Storefront
WHATSAPP_PHONE_NUMBER_ID=               # Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_LANGUAGE=en

# ---------------------------------------------------------------- shipping
SHIPPING_PROVIDER=manual                # manual (seller types AWB) | shiprocket
SHIPROCKET_EMAIL=                       # API user created in Shiprocket → Settings → API
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=               # any long random string; set the same in Shiprocket's webhook

# ---------------------------------------------------------------- AI (listing writer, listing checks, review summaries)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------- files
STORAGE_BACKEND=local                   # local | s3
MEDIA_ROOT=./var/media
PRIVATE_ROOT=./var/private
MEDIA_BASE_URL=/media                   # with S3: https://<cloudfront-domain>
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=ap-south-1

# ---------------------------------------------------------------- operator details (Consumer Protection (E-Commerce) Rules 2020)
PLATFORM_LEGAL_NAME=                    # starting values only; edit later in Admin → Storefront → Business
PLATFORM_GSTIN=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

RUN_JOBS=true
